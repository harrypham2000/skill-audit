{
  "name": "@hungpg/skill-audit",
  "version": "0.10.0",
  "description": "Security auditing CLI for AI agent skills with PII detection and an experimental compliance checklist",
  "type": "module",
  "bin": {
    "skill-audit": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "postinstall": "node scripts/postinstall.cjs",
    "security:update": "node dist/index.js --update-db",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepack": "npm run verify:pack",
    "verify:pack": "npm run clean && npm run build && node scripts/verify-tarball.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "schemas",
    "scripts",
    "references",
    "examples",
    "rules",
    "CHANGELOG.md",
    "README.md",
    "SKILL.md"
  ],
  "keywords": [
    "security",
    "audit",
    "cli",
    "ai",
    "agent",
    "skills",
    "vulnerability",
    "owasp",
    "prompt-injection",
    "llm-security"
  ],
  "author": "Hung Pham",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harrypham2000/skill-audit.git"
  },
  "bugs": {
    "url": "https://github.com/harrypham2000/skill-audit/issues"
  },
  "homepage": "https://github.com/harrypham2000/skill-audit#readme",
  "dependencies": {
    "commander": "^14.0.3",
    "gray-matter": "^4.0.3",
    "semver": "^7.8.5",
    "typescript": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "tsx": "^4.23.7",
    "vitest": "^4.1.10"
  },
  "exports": {
    ".": {
      "import": "./dist/api.js",
      "types": "./dist/api.d.ts"
    },
    "./package.json": "./package.json"
  }
}
