#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
package_dir="$repo_root/skill-audit"

run_step() {
  local label="$1"
  shift
  local started
  started="$(date +%s)"
  printf '\n==> %s\n' "$label"
  "$@"
  printf '<== %s (%ss)\n' "$label" "$(( $(date +%s) - started ))"
}

if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
  echo "Node.js and npm are required; use an orb image with Node.js 20 or later." >&2
  exit 1
fi

node_major="$(node -p 'process.versions.node.split(".")[0]')"
if (( node_major < 20 )); then
  echo "Node.js 20 or later is required (found $(node --version))." >&2
  exit 1
fi

printf 'Preparing skill-audit with Node %s and npm %s\n' "$(node --version)" "$(npm --version)"
cd -- "$package_dir"

run_step "Install locked npm dependencies" npm ci --no-audit --fund=false
run_step "Build the TypeScript package" npm run build

printf '\nOrb setup complete. Dependencies and dist/ are ready in %s.\n' "$package_dir"
